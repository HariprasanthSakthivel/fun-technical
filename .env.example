# =============================================================================
# Fun & Technical Activity Platform — environment variable template
# Copy to .env (root), frontend/.env, and/or backend/.env as needed.
# Never commit real secrets.
# =============================================================================

# --- Frontend (Vite) — place in frontend/.env ---
VITE_API_BASE_URL=http://localhost:8000

# --- Backend — place in backend/.env ---
APP_NAME=Fun & Technical Activity Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# CORS: comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite connection (SQLAlchemy URL)
# The application automatically creates the data folder if missing
DATABASE_URL=sqlite:///./data/fun_tech_activity.db

# Authentication secret key (generate a secure random string in production)
SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# Optional server bind (used by uvicorn when started via docs / scripts)
HOST=0.0.0.0
PORT=8000

